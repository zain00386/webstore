# Copy this file to .env.local and fill in real values from your Supabase project
# (Supabase dashboard > Project Settings > API). Never commit .env.local.

# Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY - never prefix with NEXT_PUBLIC_, never share
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for links and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
