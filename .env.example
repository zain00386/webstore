# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard > Project Settings > API (or "API Keys").
# .env.local is ignored by Git. Never commit it, never paste these values into chat.

# --- Safe for the browser (protected by the database security rules) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key (legacy) or "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVER ONLY: never add NEXT_PUBLIC_ to this name ---
# "service_role" key (legacy) or "secret" key (sb_secret_...). Bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address (used for links and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
